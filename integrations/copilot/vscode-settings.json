{
  "github.copilot.chat.mcp.servers": [
    {
      "name": "lumen-memory",
      "command": "python",
      "args": ["-m", "lumen.integrations.mcp_server"],
      "env": {
        "LUMEN_DEVICE": "generic",
        "LUMEN_STORE_PATH": "${userHome}/.lumen/store",
        "LUMEN_MODEL_PATH": "${userHome}/.lumen/models"
      }
    }
  ]
}
